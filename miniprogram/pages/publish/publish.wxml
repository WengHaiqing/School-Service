<view class="page publish-page">
  <view class="publish-head">
    <text class="publish-head__eyebrow">发布任务</text>
    <text class="publish-head__title">信息少一点，需求清楚一点</text>
  </view>

  <view wx:if="{{!authenticated}}" class="login-gate card">
    <text class="login-gate__title">发布前需要校园认证</text>
    <text class="login-gate__desc">完成微信、手机号和校园身份认证后即可发布。</text>
    <button class="btn btn--primary" bindtap="goLogin">去完成认证</button>
  </view>

  <block wx:else>
    <view class="wallet-strip card" bindtap="goWallet">
      <view>
        <text class="wallet-strip__label">钱包可用余额</text>
        <text class="wallet-strip__balance">¥{{walletText}}</text>
      </view>
      <text class="wallet-strip__action">充值 ›</text>
    </view>

    <view class="form-card card">
      <view class="field">
        <text class="field__label">任务分类<text class="field__required">*</text></text>
        <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
          <view class="picker-box">{{categories[categoryIndex]}} <text>⌄</text></view>
        </picker>
      </view>

      <view class="field">
        <text class="field__label">任务标题<text class="field__required">*</text></text>
        <input class="input" maxlength="20" value="{{title}}" data-field="title" bindinput="onInput" placeholder="一句话说明你的需求" />
        <text class="field__hint">{{title.length}} / 20</text>
      </view>

      <view class="field">
        <text class="field__label">备注（50字以内）</text>
        <textarea class="note-input" maxlength="50" value="{{note}}" data-field="note" bindinput="onInput" placeholder="补充数量、地点、时间或成色等必要信息" />
        <text class="field__hint">{{note.length}} / 50</text>
      </view>

      <view class="form-row">
        <view class="form-row__item">
          <text class="field__label">固定金额<text class="field__required">*</text></text>
          <view class="money-input">
            <text>¥</text>
            <input type="digit" maxlength="7" value="{{amount}}" data-field="amount" bindinput="onInput" placeholder="0.00" />
          </view>
        </view>
        <view class="form-row__item">
          <text class="field__label">接单有效期<text class="field__required">*</text></text>
          <picker mode="selector" range="{{expiryOptions}}" range-key="label" value="{{expiryIndex}}" bindchange="onExpiryChange">
            <view class="picker-box">{{expiryOptions[expiryIndex].label}} <text>⌄</text></view>
          </picker>
        </view>
      </view>
    </view>

    <text class="publish-rule">发布即表示你确认信息真实、交易合法，并同意平台规则。</text>
    <button class="btn btn--primary submit" disabled="{{submitting}}" bindtap="submit">{{submitting ? '发布中…' : '确认金额并发布'}}</button>
    <text class="payment-note">当前为开发态测试钱包，暂未接入真实微信支付。</text>
  </block>
</view>
