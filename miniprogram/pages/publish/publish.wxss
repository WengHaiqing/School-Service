.publish-page { padding-top: 16rpx; }
.publish-head { padding: 12rpx 4rpx 24rpx; }
.publish-head__eyebrow, .publish-head__title, .login-gate__title, .login-gate__desc, .wallet-strip__label, .wallet-strip__balance, .publish-rule, .payment-note { display: block; }
.publish-head__eyebrow { color: var(--brand); font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; }
.publish-head__title { margin-top: 7rpx; font-size: 36rpx; font-weight: 800; }
.login-gate { padding: 54rpx 32rpx; text-align: center; }
.login-gate__title { font-size: 31rpx; font-weight: 750; }
.login-gate__desc { margin: 10rpx 0 26rpx; color: var(--muted); font-size: 23rpx; line-height: 1.6; }
.wallet-strip { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; padding: 22rpx 26rpx; color: #fff; background: linear-gradient(135deg, #1b3c35, #087f73); }
.wallet-strip__label { color: rgba(255,255,255,.7); font-size: 20rpx; }
.wallet-strip__balance { margin-top: 3rpx; font-size: 36rpx; font-weight: 800; }
.wallet-strip__action { padding: 10rpx 16rpx; background: rgba(255,255,255,.13); border-radius: 999rpx; font-size: 21rpx; }
.form-card { padding: 30rpx; }
.picker-box { display: flex; align-items: center; justify-content: space-between; }
.note-input { width: 100%; height: 150rpx; padding: 23rpx 24rpx; background: #f7f9f7; border-radius: 20rpx; line-height: 1.55; }
.form-row { display: flex; gap: 16rpx; }
.form-row__item { flex: 1; min-width: 0; }
.money-input { display: flex; align-items: center; min-height: 88rpx; padding: 0 20rpx; color: var(--danger); background: var(--danger-soft); border-radius: 20rpx; font-size: 28rpx; font-weight: 800; }
.money-input input { flex: 1; height: 88rpx; margin-left: 8rpx; color: var(--danger); }
.form-row .picker-box { overflow: hidden; padding-right: 16rpx; padding-left: 16rpx; font-size: 23rpx; white-space: nowrap; }
.publish-rule { margin: 22rpx 10rpx 14rpx; color: var(--muted); font-size: 20rpx; line-height: 1.5; text-align: center; }
.submit { width: 100%; }
.payment-note { margin-top: 13rpx; color: var(--muted); font-size: 19rpx; text-align: center; }
