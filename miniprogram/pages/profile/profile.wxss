.profile-page {
  padding-top: 18rpx;
}

.profile-hero {
  display: flex;
  align-items: center;
  padding: 28rpx 8rpx 34rpx;
}

.profile-hero__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 104rpx;
  color: #fff;
  background: var(--brand);
  border-radius: 34rpx 18rpx 34rpx 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(8, 127, 115, 0.2);
  font-size: 38rpx;
  font-weight: 800;
}

.profile-hero__copy {
  flex: 1;
  margin-left: 22rpx;
}

.profile-hero__name-row {
  display: flex;
  align-items: center;
}

.profile-hero__name,
.profile-hero__school,
.profile-hero__contact {
  display: block;
}

.profile-hero__name {
  font-size: 36rpx;
  font-weight: 800;
}

.profile-hero__verified {
  margin-left: 12rpx;
  padding: 6rpx 12rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 700;
}

.profile-hero__school {
  margin-top: 8rpx;
  color: #53605a;
  font-size: 24rpx;
}

.profile-hero__contact {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.profile-hero__login {
  margin: 0;
  padding: 0 24rpx;
  color: #fff;
  background: var(--brand);
  border-radius: 17rpx;
  font-size: 23rpx;
}

.stats {
  display: flex;
  padding: 28rpx 10rpx;
}

.stat {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--line);
}

.stat:last-child {
  border-right: none;
}

.stat__value,
.stat__label {
  display: block;
}

.stat__value {
  font-size: 34rpx;
  font-weight: 800;
}

.stat__label {
  margin-top: 6rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.credit {
  margin-top: 20rpx;
  padding: 30rpx;
  color: #fff;
  background: linear-gradient(135deg, #1c3c35, #087f73);
}

.credit__top,
.credit__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.credit__eyebrow,
.credit__title {
  display: block;
}

.credit__eyebrow {
  color: rgba(255, 255, 255, 0.6);
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.credit__title {
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.credit__badge {
  padding: 10rpx 16rpx;
  color: #ffebb2;
  background: rgba(255, 235, 178, 0.12);
  border: 1rpx solid rgba(255, 235, 178, 0.25);
  border-radius: 999rpx;
  font-size: 21rpx;
}

.credit__bar {
  overflow: hidden;
  height: 12rpx;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
}

.credit__progress {
  height: 100%;
  background: #ffda6a;
  border-radius: 999rpx;
}

.credit__meta {
  margin-top: 13rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 20rpx;
}

.menu,
.demo {
  margin-top: 20rpx;
}

.menu {
  padding: 0 26rpx;
}

.menu__item {
  display: flex;
  align-items: center;
  padding: 25rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.menu__item:last-child {
  border-bottom: none;
}

.menu__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.menu__icon--gold {
  color: #9b661e;
  background: #fff3d3;
}

.menu__icon--blue {
  color: #3e6a9b;
  background: #e9f2fc;
}

.menu__copy {
  flex: 1;
  margin-left: 17rpx;
}

.menu__title,
.menu__desc {
  display: block;
}

.menu__title {
  font-size: 27rpx;
  font-weight: 700;
}

.menu__desc {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.menu__arrow {
  color: #aeb5b1;
  font-size: 40rpx;
}

.demo {
  padding: 26rpx;
}

.demo__title,
.demo__desc {
  display: block;
}

.demo__title {
  font-size: 27rpx;
  font-weight: 750;
}

.demo__desc {
  margin-top: 8rpx;
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.6;
}

.demo__button {
  min-height: 74rpx;
  margin-top: 20rpx;
  font-size: 23rpx;
}
