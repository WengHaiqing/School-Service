.order-detail {
  padding-top: 12rpx;
}

.order-loading {
  padding-top: 18rpx;
}

.order-skeleton {
  margin-bottom: 20rpx;
  background: linear-gradient(90deg, #edf1ee 25%, #f7f9f7 50%, #edf1ee 75%);
  background-size: 400% 100%;
  border-radius: 28rpx;
  animation: order-skeleton-loading 1.1s ease-in-out infinite;
}

.order-skeleton--hero { height: 210rpx; }
.order-skeleton--card { height: 260rpx; }
.order-skeleton--row { height: 120rpx; }

@keyframes order-skeleton-loading {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

.status-hero {
  margin-bottom: 20rpx;
  padding: 34rpx;
  color: #fff;
  background: linear-gradient(135deg, #087f73, #075f57);
  border-radius: 30rpx;
}

.status-hero--grace,
.status-hero--disputed {
  background: linear-gradient(135deg, #b95c33, #853c2b);
}

.status-hero--completed,
.status-hero--canceled {
  background: linear-gradient(135deg, #65716b, #48514d);
}

.status-hero__eyebrow,
.status-hero__title,
.status-hero__desc {
  display: block;
}

.status-hero__eyebrow {
  color: rgba(255, 255, 255, 0.68);
  font-size: 21rpx;
  font-weight: 700;
}

.status-hero__title {
  margin-top: 8rpx;
  font-size: 43rpx;
  font-weight: 800;
}

.status-hero__desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.6;
}

.summary,
.action-card,
.evidence-card,
.dispute-card,
.chat-entry,
.timeline {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.summary__top,
.summary__peer,
.summary__time,
.chat-entry,
.dispute-card__actions {
  display: flex;
  align-items: center;
}

.summary__top,
.summary__time {
  justify-content: space-between;
}

.summary__title {
  max-width: 510rpx;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.4;
}

.summary__peer {
  margin: 24rpx 0;
  padding: 20rpx;
  background: #f6f8f6;
  border-radius: 20rpx;
}

.summary__avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  color: #fff;
  background: var(--brand);
  border-radius: 20rpx;
  font-weight: 800;
}

.summary__copy {
  margin-left: 15rpx;
}

.summary__name,
.summary__meta {
  display: block;
}

.summary__name {
  font-size: 27rpx;
  font-weight: 750;
}

.summary__meta {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.summary__time {
  padding: 14rpx 0;
  color: var(--muted);
  font-size: 23rpx;
  border-top: 1rpx solid var(--line);
}

.summary__time text:last-child {
  color: var(--ink);
  font-weight: 650;
}

.action-card__eyebrow,
.action-card__title,
.action-card__desc,
.evidence-card__label,
.evidence-card__text,
.evidence-card__time,
.dispute-card__title {
  display: block;
}

.action-card__eyebrow {
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.action-card__title {
  margin-top: 7rpx;
  font-size: 31rpx;
  font-weight: 750;
}

.action-card__desc {
  margin: 10rpx 0 22rpx;
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.action-card__button {
  width: 100%;
  margin-top: 18rpx;
}

.action-card__button--minor {
  margin-top: 12rpx;
}

.evidence-card {
  background: var(--success-soft);
}

.evidence-card__label {
  color: var(--brand-dark);
  font-size: 22rpx;
  font-weight: 750;
}

.evidence-card__text {
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.7;
}

.evidence-card__time {
  margin-top: 14rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.dispute-card__title {
  margin-bottom: 18rpx;
  color: var(--danger);
  font-size: 29rpx;
  font-weight: 750;
}

.dispute-card__actions {
  gap: 14rpx;
  margin-top: 18rpx;
}

.dispute-card__actions button {
  flex: 1;
  margin: 0;
}

.minor-action {
  padding: 12rpx 0 26rpx;
  color: var(--danger);
  font-size: 23rpx;
  text-align: center;
}

.chat-entry {
  min-height: 112rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid rgba(8, 127, 115, 0.12);
}

.chat-entry__icon {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  color: #fff;
  background: var(--brand);
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(8, 127, 115, 0.2);
}

.chat-entry__copy {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.chat-entry__title,
.chat-entry__desc {
  display: block;
}

.chat-entry__title {
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 750;
}

.chat-entry__desc {
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--muted);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-entry__arrow {
  margin-left: 14rpx;
  color: var(--brand);
  font-size: 46rpx;
  line-height: 1;
}

.timeline__title {
  display: block;
  margin-bottom: 22rpx;
  font-size: 30rpx;
  font-weight: 750;
}

.timeline__item {
  display: flex;
  gap: 18rpx;
  padding-bottom: 25rpx;
}

.timeline__item:last-child {
  padding-bottom: 0;
}

.timeline__dot {
  width: 18rpx;
  height: 18rpx;
  margin-top: 7rpx;
  background: var(--brand);
  border: 5rpx solid var(--brand-soft);
  border-radius: 50%;
}

.timeline__copy {
  flex: 1;
}

.timeline__event,
.timeline__detail,
.timeline__time {
  display: block;
}

.timeline__event {
  font-size: 25rpx;
  font-weight: 700;
}

.timeline__detail {
  margin-top: 5rpx;
  color: #56615b;
  font-size: 22rpx;
  line-height: 1.5;
}

.timeline__time {
  margin-top: 5rpx;
  color: #9aa39e;
  font-size: 19rpx;
}

.back-button {
  width: 280rpx;
  min-height: 78rpx;
  margin-top: 26rpx;
}
