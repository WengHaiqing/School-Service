.home { padding: 18rpx 20rpx 40rpx; }
.home-head { display: flex; align-items: center; justify-content: space-between; padding: 10rpx 4rpx 22rpx; }
.home-head__eyebrow, .home-head__title, .home-head__slogan, .locator__label, .locator__value, .category-card__name, .category-card__desc, .task-head__title, .task-head__count, .task-card__title, .task-card__note { display: block; }
.home-head__eyebrow { color: var(--brand); font-size: 19rpx; font-weight: 800; letter-spacing: 3rpx; }
.home-head__title { max-width: 560rpx; margin-top: 7rpx; overflow: hidden; font-size: 38rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.home-head__slogan { margin-top: 4rpx; color: var(--muted); font-size: 21rpx; }
.home-head__mark { display: flex; align-items: center; justify-content: center; width: 66rpx; height: 66rpx; color: #fff; background: var(--brand); border-radius: 20rpx 10rpx 20rpx 10rpx; box-shadow: 0 10rpx 24rpx rgba(8, 127, 115, 0.2); font-size: 27rpx; font-weight: 800; }
.locator { display: flex; align-items: stretch; min-height: 96rpx; overflow: hidden; padding: 10rpx; }
.locator__region { flex: 0 0 228rpx; width: 228rpx; }
.locator__region-row { display: flex; height: 100%; }
.locator__cell, .locator__school { display: flex; flex-direction: column; justify-content: center; min-width: 0; padding: 7rpx 14rpx; border-right: 1rpx solid var(--line); }
.locator__cell { width: 114rpx; padding-right: 10rpx; padding-left: 10rpx; }
.locator__label { color: var(--muted); font-size: 18rpx; }
.locator__value, .locator__school-input { height: 38rpx; margin-top: 4rpx; overflow: hidden; font-size: 22rpx; font-weight: 700; line-height: 38rpx; text-overflow: ellipsis; white-space: nowrap; }
.locator__school { flex: 1; min-width: 0; padding-right: 10rpx; padding-left: 12rpx; }
.locator__button { display: flex; flex: 0 0 96rpx; align-items: center; justify-content: center; width: 96rpx; min-width: 96rpx; max-width: 96rpx; min-height: 76rpx; margin: 0; padding: 0; color: #fff; background: var(--brand); border-radius: 18rpx; font-size: 21rpx; font-weight: 700; line-height: 1; }
.category-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 18rpx; }
.category-card { display: flex; align-items: center; min-width: 0; padding: 18rpx 12rpx; background: #fff; border: 2rpx solid transparent; border-radius: 20rpx; }
.category-card--active { background: var(--brand-soft); border-color: rgba(8, 127, 115, 0.25); }
.category-card__icon { margin-right: 9rpx; font-size: 28rpx; }
.category-card__name { font-size: 21rpx; font-weight: 750; white-space: nowrap; }
.category-card__desc { margin-top: 2rpx; color: var(--muted); font-size: 17rpx; }
.task-head { display: flex; align-items: center; justify-content: space-between; margin: 28rpx 4rpx 16rpx; }
.task-head__title { font-size: 31rpx; font-weight: 800; }
.task-head__count { margin-top: 3rpx; color: var(--muted); font-size: 19rpx; }
.task-head__actions { display: flex; flex-shrink: 0; align-items: center; gap: 10rpx; }
.amount-sort { display: flex; align-items: center; height: 60rpx; overflow: hidden; background: #fff; border: 1rpx solid var(--line); border-radius: 16rpx; }
.amount-sort__label { padding: 0 10rpx 0 13rpx; color: var(--muted); font-size: 18rpx; }
.amount-sort__arrow { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 60rpx; color: #929a96; border-left: 1rpx solid var(--line); font-size: 24rpx; font-weight: 800; }
.amount-sort__arrow--active { color: #fff; background: var(--brand); }
.task-head__publish { display: flex; flex: 0 0 144rpx; align-items: center; justify-content: center; width: 144rpx; min-width: 144rpx; max-width: 144rpx; height: 60rpx; min-height: 60rpx; margin: 0; padding: 0; color: #fff; background: var(--brand); border-radius: 16rpx; font-size: 21rpx; font-weight: 700; line-height: 1; text-align: center; }
.task-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.task-card { display: flex; flex-direction: column; min-width: 0; min-height: 232rpx; padding: 20rpx; border-radius: 22rpx; }
.task-card__top, .task-card__bottom { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.task-card__category { overflow: hidden; color: var(--brand); font-size: 19rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.task-card__money { color: var(--danger); font-size: 27rpx; font-weight: 800; }
.task-card__title { display: -webkit-box; margin-top: 16rpx; overflow: hidden; font-size: 27rpx; font-weight: 750; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.task-card__note { margin-top: 8rpx; overflow: hidden; color: var(--muted); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.task-card__bottom { margin-top: auto; padding-top: 15rpx; color: var(--muted); font-size: 18rpx; }
.task-card__deadline { color: var(--warning); }
.empty { padding: 58rpx 28rpx; }
.empty__button { width: 240rpx; min-height: 72rpx; margin-top: 22rpx; font-size: 23rpx; }
.auth-tip { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 20rpx; color: var(--muted); font-size: 20rpx; }
.auth-tip button { min-height: 56rpx; margin: 0; padding: 0 18rpx; color: var(--brand); background: var(--brand-soft); border-radius: 14rpx; font-size: 20rpx; }
