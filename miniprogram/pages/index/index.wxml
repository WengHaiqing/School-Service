<view class="page home">
  <view class="home-head">
    <view>
      <text class="home-head__eyebrow">校园青蜓 · CAMPUS</text>
      <text class="home-head__title">{{locatedSchool || '选择你的学校'}}</text>
      <text class="home-head__slogan">校园需求，简单成交</text>
    </view>
    <view class="home-head__mark">蜓</view>
  </view>

  <view class="locator card">
    <picker class="locator__region" mode="region" value="{{region}}" bindchange="onRegionChange">
      <view class="locator__region-row">
        <view class="locator__cell">
          <text class="locator__label">省</text>
          <text class="locator__value">{{region[0] || '请选择'}}</text>
        </view>
        <view class="locator__cell">
          <text class="locator__label">市</text>
          <text class="locator__value">{{region[1] || '请选择'}}</text>
        </view>
      </view>
    </picker>
    <view class="locator__school">
      <text class="locator__label">学校</text>
      <input class="locator__school-input" value="{{schoolInput}}" bindinput="onSchoolInput" confirm-type="done" bindconfirm="applyLocation" placeholder="输入学校全称" />
    </view>
    <button class="locator__button" bindtap="applyLocation">确定</button>
  </view>

  <view class="category-grid">
    <view class="category-card {{activeCategory === item.name ? 'category-card--active' : ''}}" wx:for="{{categories}}" wx:key="name" data-name="{{item.name}}" bindtap="chooseCategory">
      <text class="category-card__icon">{{item.icon}}</text>
      <view>
        <text class="category-card__name">{{item.name}}</text>
        <text class="category-card__desc">{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="task-head">
    <view>
      <text class="task-head__title">{{activeCategory === '全部' ? '本校最新任务' : activeCategory}}</text>
      <text class="task-head__count">当前显示 {{tasks.length}} 条</text>
    </view>
    <view class="task-head__actions">
      <view class="amount-sort">
        <text class="amount-sort__label">金额</text>
        <view class="amount-sort__arrow {{amountSort === 'asc' ? 'amount-sort__arrow--active' : ''}}" data-sort="asc" bindtap="chooseAmountSort" aria-label="金额由低到高">↑</view>
        <view class="amount-sort__arrow {{amountSort === 'desc' ? 'amount-sort__arrow--active' : ''}}" data-sort="desc" bindtap="chooseAmountSort" aria-label="金额由高到低">↓</view>
      </view>
      <button class="task-head__publish" bindtap="goPublish">＋ 发布</button>
    </view>
  </view>

  <view wx:if="{{tasks.length}}" class="task-grid">
    <view class="task-card card" wx:for="{{tasks}}" wx:key="id" data-id="{{item.id}}" bindtap="openTask">
      <view class="task-card__top">
        <text class="task-card__category">{{item.category}}</text>
        <text class="task-card__money">¥{{item.amount}}</text>
      </view>
      <text class="task-card__title">{{item.title}}</text>
      <text wx:if="{{item.note}}" class="task-card__note">{{item.note}}</text>
      <view class="task-card__bottom">
        <text>{{item.campus}}</text>
        <text class="task-card__deadline">{{item.deadlineText}}</text>
      </view>
    </view>
  </view>

  <view wx:else class="empty card">
    <view class="empty__icon">🍃</view>
    <text class="empty__title">这所学校暂时没有待接任务</text>
    <text class="empty__desc">切换学校或分类，也可以发布第一条需求。</text>
    <button class="btn btn--primary empty__button" bindtap="goPublish">发布任务</button>
  </view>

  <view wx:if="{{!authenticated}}" class="auth-tip card">
    <text>浏览无需登录，发布与接单前需要校园认证。</text>
    <button bindtap="goLogin">去认证</button>
  </view>
</view>
