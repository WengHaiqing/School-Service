page {
  height: 100%;
  overflow: hidden;
  background: #f6f8f4;
}

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
}

.chat-context {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  margin: 18rpx 24rpx 0;
  padding: 20rpx 22rpx;
  background: #fff;
  border: 1rpx solid rgba(8, 127, 115, 0.1);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(31, 60, 51, 0.06);
}

.chat-context__avatar,
.message-avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: var(--brand);
  font-weight: 800;
}

.chat-context__avatar {
  width: 66rpx;
  height: 66rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.chat-context__copy {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
}

.chat-context__name,
.chat-context__task {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-context__name {
  font-size: 27rpx;
  font-weight: 750;
}

.chat-context__task {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 21rpx;
}

.chat-context__status {
  flex: 0 0 auto;
  margin-left: 14rpx;
  padding: 8rpx 14rpx;
  color: var(--brand-dark);
  background: var(--brand-soft);
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.chat-notice {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx 12rpx;
  color: #7c8580;
  font-size: 20rpx;
}

.chat-notice__rules {
  margin-left: 20rpx;
  color: var(--brand);
  font-weight: 700;
}

.message-list {
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
  padding: 16rpx 24rpx 28rpx;
}

.chat-empty {
  display: flex;
  align-items: center;
  flex-direction: column;
  padding: 120rpx 32rpx 60rpx;
  color: var(--muted);
  text-align: center;
}

.chat-empty__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 26rpx;
  font-size: 27rpx;
  font-weight: 800;
}

.chat-empty__title,
.chat-empty__desc {
  display: block;
}

.chat-empty__title {
  margin-top: 22rpx;
  color: var(--ink);
  font-size: 27rpx;
  font-weight: 750;
}

.chat-empty__desc {
  margin-top: 9rpx;
  font-size: 21rpx;
}

.message-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.message-row--mine {
  justify-content: flex-end;
}

.message-avatar {
  width: 54rpx;
  height: 54rpx;
  margin-right: 12rpx;
  border-radius: 18rpx;
  font-size: 21rpx;
}

.message-content {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
  max-width: 76%;
}

.message-row--mine .message-content {
  align-items: flex-end;
}

.message-bubble {
  display: block;
  padding: 18rpx 22rpx;
  color: var(--ink);
  background: #fff;
  border: 1rpx solid #e5ebe7;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  font-size: 25rpx;
  line-height: 1.55;
  overflow-wrap: break-word;
  white-space: pre-wrap;
  word-break: break-all;
  box-shadow: 0 7rpx 20rpx rgba(31, 60, 51, 0.05);
}

.message-row--mine .message-bubble {
  color: #fff;
  background: var(--brand);
  border-color: var(--brand);
  border-radius: 24rpx 8rpx 24rpx 24rpx;
}

.message-time {
  margin-top: 7rpx;
  color: #99a19d;
  font-size: 18rpx;
}

.chat-composer {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e4e9e6;
  box-shadow: 0 -10rpx 30rpx rgba(31, 60, 51, 0.05);
}

.chat-composer__input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 22rpx;
  background: #f1f4f2;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.chat-composer__send {
  flex: 0 0 104rpx;
  width: 104rpx;
  min-width: 104rpx;
  max-width: 104rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  color: #fff;
  background: var(--brand);
  border-radius: 20rpx;
  font-size: 23rpx;
  font-weight: 750;
  line-height: 76rpx;
}

.chat-composer__send[disabled] {
  color: rgba(255, 255, 255, 0.8);
  background: #9dc9c3;
}

.chat-composer__send::after {
  border: 0;
}

.chat-closed {
  flex: 0 0 auto;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  color: var(--muted);
  background: #fff;
  border-top: 1rpx solid #e4e9e6;
  font-size: 22rpx;
  text-align: center;
}

.loading-card {
  margin-top: 24rpx;
  padding: 50rpx 30rpx;
  color: var(--muted);
  text-align: center;
}

.back-button {
  width: 280rpx;
  min-height: 78rpx;
  margin-top: 26rpx;
}
