.orders-page {
  padding-top: 12rpx;
}

.orders-head {
  padding: 20rpx 4rpx 28rpx;
}

.orders-head__eyebrow,
.orders-head__title,
.orders-head__desc {
  display: block;
}

.orders-head__eyebrow {
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.orders-head__title {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.orders-head__desc {
  margin-top: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.cloud-warning {
  margin-bottom: 22rpx;
  padding: 22rpx 24rpx;
  color: #7b4b16;
  background: var(--warning-soft);
  border: 1rpx solid rgba(196, 126, 39, 0.2);
  border-radius: 20rpx;
}

.cloud-warning__title,
.cloud-warning__desc {
  display: block;
}

.cloud-warning__title {
  font-size: 24rpx;
  font-weight: 800;
}

.cloud-warning__desc {
  margin-top: 6rpx;
  font-size: 21rpx;
  line-height: 1.55;
}

.tabs {
  display: flex;
  padding: 8rpx;
  background: #e9eeeb;
  border-radius: 22rpx;
}

.inquiry-section {
  margin-bottom: 22rpx;
  padding: 26rpx;
}

.inquiry-section__head,
.inquiry-item,
.inquiry-item__line {
  display: flex;
  align-items: center;
}

.inquiry-section__head,
.inquiry-item__line {
  justify-content: space-between;
}

.inquiry-section__title,
.inquiry-section__desc,
.inquiry-item__task,
.inquiry-item__preview {
  display: block;
}

.inquiry-section__title {
  font-size: 29rpx;
  font-weight: 800;
}

.inquiry-section__desc {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.inquiry-section__total,
.inquiry-item__badge {
  color: #fff;
  background: var(--danger);
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 750;
}

.inquiry-section__total {
  padding: 8rpx 14rpx;
}

.inquiry-item {
  position: relative;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.inquiry-item__avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  color: #fff;
  background: var(--brand);
  border-radius: 19rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.inquiry-item__copy {
  flex: 1;
  min-width: 0;
  margin-left: 14rpx;
  padding-right: 34rpx;
}

.inquiry-item__name {
  overflow: hidden;
  font-size: 23rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inquiry-item__time {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #9aa29e;
  font-size: 18rpx;
}

.inquiry-item__task,
.inquiry-item__preview {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.inquiry-item__task {
  margin-top: 5rpx;
  color: #55615b;
  font-size: 21rpx;
}

.inquiry-item__preview {
  margin-top: 5rpx;
  color: var(--muted);
  font-size: 20rpx;
}

.inquiry-item__preview--unread {
  color: var(--danger);
  font-weight: 700;
}

.inquiry-item__badge {
  position: absolute;
  right: 0;
  bottom: 14rpx;
  min-width: 34rpx;
  padding: 4rpx 8rpx;
  text-align: center;
}

.inquiry-item__arrow {
  position: absolute;
  right: 2rpx;
  bottom: 10rpx;
  color: var(--brand);
  font-size: 40rpx;
}

.tab {
  flex: 1;
  padding: 18rpx 0;
  color: var(--muted);
  border-radius: 16rpx;
  font-size: 24rpx;
  text-align: center;
}

.tab--active {
  color: var(--ink);
  background: #fff;
  box-shadow: 0 6rpx 18rpx rgba(31, 60, 51, 0.08);
  font-weight: 750;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 22rpx;
}

.order-card {
  padding: 28rpx;
}

.order-card__head,
.order-card__peer,
.order-card__foot {
  display: flex;
  align-items: center;
}

.order-card__head,
.order-card__foot {
  justify-content: space-between;
}

.order-card__role {
  display: flex;
  align-items: center;
  padding: 7rpx 13rpx;
  border: 1rpx solid currentColor;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.order-card__role--publish {
  color: var(--brand);
  background: var(--brand-soft);
}

.order-card__role--accept {
  color: var(--danger);
  background: var(--danger-soft);
}

.order-card__role-dot {
  margin-right: 8rpx;
  font-size: 13rpx;
}

.order-card__title {
  display: block;
  margin: 20rpx 0;
  font-size: 31rpx;
  font-weight: 750;
  line-height: 1.45;
}

.order-card__peer {
  color: #53605a;
  font-size: 23rpx;
}

.peer-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  margin-right: 10rpx;
  color: #fff;
  background: var(--brand);
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 700;
}

.peer-star {
  margin-left: auto;
  color: #a76a16;
}

.order-card__foot {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--line);
}

.order-card__message {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  color: #8a938e;
  background: #f3f5f4;
  border-radius: 16rpx;
  font-size: 21rpx;
}

.order-card__message--history {
  color: var(--brand-dark);
  background: var(--brand-soft);
}

.order-card__message--unread {
  color: var(--danger);
  background: var(--danger-soft);
  font-weight: 700;
}

.order-card__message-dot {
  flex: 0 0 auto;
  margin-right: 9rpx;
  font-size: 15rpx;
}

.order-card__message-text {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-card__label,
.order-card__due {
  display: block;
}

.order-card__label {
  color: var(--muted);
  font-size: 20rpx;
}

.order-card__due {
  margin-top: 5rpx;
  font-size: 23rpx;
  font-weight: 650;
}

.empty {
  margin-top: 24rpx;
}

.empty-button {
  width: 260rpx;
  min-height: 76rpx;
  margin-top: 28rpx;
}
